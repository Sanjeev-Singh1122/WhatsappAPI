<!DOCTYPE html>
<html>

<head>

    <title>LUXE Fashion</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial;
        }

        body {
            background: #f5f5f5;
        }

        .navbar {

            width: 100%;
            padding: 20px 50px;
            background: white;

            display: flex;
            justify-content: space-between;
            align-items: center;

            position: fixed;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-size: 40px;
            font-weight: bold;
        }

        .menu a {
            margin-left: 30px;
            text-decoration: none;
            color: black;
            font-size: 18px;
        }

        .hero {

            width: 100%;
            heighthero 100vh;

            background-image:
            linear-gradient(rgba(0,0,0,0.5),
            rgba(0,0,0,0.5)),
            url('/images/banner.jpg');

            background-size: cover;
            background-position: center;

            display: flex;
            justify-content: space-between;
            align-items: center;

            padding: 100px 80px;

        }

        .left {

            width: 50%;
            color: white;

        }

        .left h1 {

            font-size: 60px;
            margin-bottom: 20px;

        }

        .left p {

            font-size: 28px;
            line-height: 45px;

        }

        .highlight {
            color: gold;
            font-weight: bold;
        }

        .form-box {

            width: 400px;

            background: rgba(0,0,0,0.8);

            padding: 30px;

            border-radius: 15px;

            color: white;

            backdrop-filter: blur(10px);

        }

        .form-box h2 {

            margin-bottom: 20px;
            text-align: center;

        }

        .form-box input {

            width: 100%;
            padding: 14px;

            margin-bottom: 15px;

            border: none;
            border-radius: 5px;

            font-size: 16px;

        }

        .btn {

            width: 100%;
            padding: 14px;

            background: gold;
            color: black;

            border: none;

            font-size: 18px;
            font-weight: bold;

            cursor: pointer;

            border-radius: 5px;

        }

        .btn:hover {
            background: orange;
        }

        .links {

            margin-top: 20px;
            text-align: center;

        }

        .links a {

            color: white;
            margin: 10px;
            text-decoration: none;

            font-size: 16px;

        }

        @media(max-width: 900px) {

            .hero {

                flex-direction: column;
                justify-content: center;
                text-align: center;

                padding: 120px 20px;

            }

            .left {

                width: 100%;
                margin-bottom: 30px;

            }

            .left h1 {
                font-size: 40px;
            }

            .left p {
                font-size: 22px;
                line-height: 35px;
            }

            .form-box {
                width: 100%;
                max-width: 400px;
            }

            .navbar {

                padding: 20px;

            }

            .menu {
                display: none;
            }

        }

    </style>

</head>

<body>

<div class="navbar">

    <div class="logo">
        LUXE
    </div>

    <div class="menu">

        <a href="#">New Arrivals</a>
        <a href="#">Mens</a>
        <a href="#">Womens</a>
        <a href="#">Collections</a>
        <a href="#">Support</a>

    </div>

</div>

<div class="hero">

    <div class="left">

        <h1>
            SHARE YOUR FRIEND AND FAMILY CONTACT DETAIL
        </h1>

        <p>

            AND GET
            <span class="highlight">
                FREE GIFT COUPONS
            </span>

            OF FRENCH CONNECTION PROMO T SHIRT.

        </p>

    </div>

    <div class="form-box">

        <h2>
            CLAIM YOUR T-SHIRT NOW!
        </h2>

        <form action="/send" method="POST">

            <input
            type="text"
            name="phone"
            placeholder="Enter Phone Number"
            required
            />

            <button class="btn" type="submit">
                SEND NOW & GET YOUR COUPON
            </button>

        </form>

        <div class="links">

            <a href="/entries">
                Show Entries
            </a>

            <a href="/download-pdf">
                Download PDF
            </a>

        </div>

    </div>

</div>

</body>

</html>